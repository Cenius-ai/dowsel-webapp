# Dowsel reads these straight from the process environment. It does not parse
# .env files (no third-party dotenv loader), so copying this file is optional -
# every value below is already the built-in default and nothing is required.

# Where the tally JSON document lives, relative to the current directory.
DOWSEL_STATE_FILE=.dowsel.json

# Set to any non-empty value to switch ANSI colour off (empty = colour on a TTY).
NO_COLOR=
